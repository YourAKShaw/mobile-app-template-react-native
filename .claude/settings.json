{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test *)",
      "Bash(npm run test *)",
      "Bash(npm run doctor)",
      "Bash(npm run rename -- --check)",
      "Bash(npx expo config *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(npx expo install *)",
      "Bash(npm run prebuild *)",
      "Bash(npx expo prebuild *)",
      "Bash(npx eas-cli *)",
      "Bash(npx eas-cli@latest *)",
      "Bash(eas *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.preview)",
      "Read(./.env.production)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  }
}
