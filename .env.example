# Copy to .env (gitignored) and adjust. Expo loads .env files automatically.
# Variables prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time:
# they are visible to anyone who unpacks the app. Never put secrets here.

# Base URL of your backend API. The default points at JSONPlaceholder, a public
# demo API used only by the example "posts" feature. Replace it.
EXPO_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com

# Build variant read by app.config.ts: development | preview | production.
# EAS sets this per profile in eas.json; locally it defaults to development.
APP_VARIANT=development
